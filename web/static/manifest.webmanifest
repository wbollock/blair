{
	"name": "Blair",
	"short_name": "Blair",
	"description": "Tasks and notes that never lose what you just added.",
	"start_url": "/today?source=pwa",
	"scope": "/",
	"display": "standalone",
	"background_color": "#FAF8F5",
	"theme_color": "#B84A33",
	"icons": [
		{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
		{ "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
		{ "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
		{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
	],
	"shortcuts": [
		{ "name": "New task", "url": "/today?capture=task", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
		{ "name": "Inbox", "url": "/inbox", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
	]
}
