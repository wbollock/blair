{
	"name": "blair-web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "npm run vendor && vite build",
		"vendor": "mkdir -p static/vendor/scalar && cp node_modules/@scalar/api-reference/dist/browser/standalone.js static/vendor/scalar/standalone.js",
		"gen:api": "npx -y openapi-typescript@7.13.0 ../api/openapi.yaml -o src/lib/api/schema.d.ts",
		"prepare": "svelte-kit sync || echo",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"e2e": "playwright test"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/source-serif-4": "^5.3.1",
		"@fontsource/geist-mono": "^5.3.0",
		"@lucide/svelte": "^1.79.0",
		"@playwright/test": "^1.65.1",
		"@scalar/api-reference": "^1.83.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/markdown-it": "^14.2.0",
		"@types/qrcode": "^1.5.6",
		"bits-ui": "^2.22.0",
		"dompurify": "^3.5.0",
		"markdown-it": "^15.0.3",
		"openapi-fetch": "^0.17.0",
		"qrcode": "^1.5.4",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	}
}
