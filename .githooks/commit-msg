#!/bin/sh
# Enforce Conventional Commits: type(scope)!: subject
# Enable with: git config core.hooksPath .githooks  (mise run hooks)
msg_file="$1"
first_line=$(head -n1 "$msg_file")

case "$first_line" in
	Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .{1,72}$'
if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
	echo "commit-msg: subject is not a Conventional Commit:" >&2
	echo "  $first_line" >&2
	echo "expected: type(scope): subject   (types: feat fix docs style refactor perf test build ci chore revert)" >&2
	exit 1
fi
